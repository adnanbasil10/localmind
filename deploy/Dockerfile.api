# §16 — multi-stage, non-root, small. Target: <500 MB API image.
#
# PIN THE BASE DIGEST BEFORE PRODUCTION USE. §16 asks for pinned digests, and a floating tag
# makes "reproduces with one command" false. Resolve the current digest with:
#     docker buildx imagetools inspect python:3.11-slim-bookworm --format '{{.Manifest.Digest}}'
# then append `@sha256:<digest>` to both FROM lines. Left unpinned rather than filled with an
# invented digest, which would simply fail to pull.
#
# The API deliberately installs `[rag,obs]` and NOT torch: `localmind.api.main` imports cleanly
# without it (verified), because the agent depends on the ControlPlane Protocol rather than on
# the model package. That keeps this image small. The inference server is a separate concern.

# ---- builder ----
FROM python:3.11-slim-bookworm AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy

# uv via pip: version-agnostic and one less registry to depend on than COPY --from an image tag.
RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml README.md ./
COPY localmind ./localmind

# NON-editable on purpose. An editable install writes a finder pointing at /build/localmind, which
# does not exist in the runtime stage — copying only /opt/venv then ImportErrors on start. A regular
# install materialises the package inside site-packages, so the venv is self-contained.
RUN uv venv /opt/venv \
 && VIRTUAL_ENV=/opt/venv uv pip install --no-cache ".[rag,obs]" \
 && find /opt/venv -name '__pycache__' -type d -prune -exec rm -rf {} + \
 && find /opt/venv -name '*.pyc' -delete

# ---- runtime ----
FROM python:3.11-slim-bookworm

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN groupadd --gid 10001 localmind \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin localmind

COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
# `localmind` is NOT copied here — it lives in site-packages via the non-editable install above.
# Copying it would shadow the installed package with an identical tree for no benefit.
COPY --chown=10001:10001 configs ./configs

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health',timeout=2).status==200 else 1)"

# Serves the demo app: the same gateway, with the packaged sample corpus indexed at startup, so
# `docker run` is useful out of the box. The corpus ships inside the wheel and is read via
# importlib.resources, so nothing extra is copied here.
#
# For the bare gateway with no retriever (production, where you inject your own), override:
#     docker run … localmind-api uvicorn localmind.api.main:app --host 0.0.0.0 --port 8000
# Point it at your own corpus with -e LOCALMIND_DEMO_CORPUS=/data/corpus.jsonl (mount it first).
CMD ["uvicorn", "localmind.api.demo:app", "--host", "0.0.0.0", "--port", "8000"]
